# ==========================================================================
# Copy this file to ".env" and fill in your values.
#   Windows PowerShell:  Copy-Item .env.example .env
#   macOS / Linux:       cp .env.example .env
# ".env" is git-ignored, so your real keys never reach the repository.
# ==========================================================================

# ----- LLM provider -------------------------------------------------------
# mock      -> no API key needed. Retrieval runs for real, no LLM is called.
# openai    -> OpenAI, or any OpenAI-compatible API (set LLM_BASE_URL).
# anthropic -> Anthropic Claude.
LLM_PROVIDER=mock

# Your API key. Leave blank when LLM_PROVIDER=mock. NEVER commit a real key.
LLM_API_KEY=

# Model name. Leave blank to use the provider's default.
#   openai    -> gpt-4o-mini
#   anthropic -> claude-haiku-4-5-20251001
LLM_MODEL=

# Optional. Point the OpenAI client at another OpenAI-compatible server,
# e.g. https://api.groq.com/openai/v1  or  http://localhost:11434/v1 (Ollama).
LLM_BASE_URL=

# 0.0 keeps answers factual and repeatable, which is what RAG wants.
LLM_TEMPERATURE=0.0
LLM_MAX_TOKENS=600

# ----- Embeddings ---------------------------------------------------------
# Downloaded from Hugging Face on first run (~80 MB) and cached locally.
EMBEDDING_MODEL=all-MiniLM-L6-v2

# ----- RAG parameters -----------------------------------------------------
# Characters per chunk. Smaller = more precise retrieval, less context.
CHUNK_SIZE=1000
# Characters repeated between neighbouring chunks. Must be < CHUNK_SIZE.
CHUNK_OVERLAP=200
# How many chunks are retrieved and sent to the LLM.
TOP_K=4
# Chunks below this cosine similarity are ignored. This is what lets the app
# answer "not found in the document" instead of forcing a bad match.
MIN_SIMILARITY=0.20

# ----- Server -------------------------------------------------------------
MAX_UPLOAD_MB=20
API_HOST=127.0.0.1
API_PORT=8000
